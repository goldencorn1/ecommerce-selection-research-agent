# B5 offline demo configuration.
# This file intentionally contains no real credentials and is not required by
# docker-compose.demo.yml. Copy it only when you want a visible configuration
# checklist beside the demo artifacts.
APP_ENV=demo
DEBUG=false
ECOMMERCE_AUTH_MODE=anonymous_local
# D2 optional signed workspace boundary; keep false for the no-key demo.
ECOMMERCE_WORKSPACE_TOKEN_SECRET=
ECOMMERCE_REQUIRE_WORKSPACE_TOKEN=false
ECOMMERCE_WORKSPACE_TOKEN_TTL=86400
# D3 optional strict Bearer JWT boundary; keep false for the anonymous demo.
ECOMMERCE_REQUIRE_BEARER_AUTH=false
ECOMMERCE_JWT_HS256_SECRET=
ECOMMERCE_JWT_ISSUER=
ECOMMERCE_JWT_AUDIENCE=
# D4 OIDC/JWKS is opt-in and requires a real identity provider.
ECOMMERCE_BEARER_PROVIDER=hs256
ECOMMERCE_OIDC_ISSUER=
ECOMMERCE_OIDC_AUDIENCE=
ECOMMERCE_OIDC_JWKS_URL=
ECOMMERCE_OIDC_ALGORITHMS=RS256
# D5 external integration is opt-in; values are never shipped to the browser.
ECOMMERCE_POSTGRES_DSN=
ECOMMERCE_AUTHORIZED_DATA_FILE=
SEARCH_API=tavily
TAVILY_API_KEY=
DEEPSEEK_API_KEY=
INFOQUEST_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api
